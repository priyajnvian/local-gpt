{
  "manifest_version": 3,
  "name": "Local GPT - Private AI Assistant",
  "version": "1.0",
  "description": "Local GPT runs entirely in your browser, ensuring your data never leaves your device.",
  "permissions": [
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Local GPT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "styles.css", "webpage.html", "extension-webpage.js", "webllm.js", "chat.js", "server-chat.js", "icons/*", "models/Qwen2.5-0.5B-Instruct-q4f16_1-MLC/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}